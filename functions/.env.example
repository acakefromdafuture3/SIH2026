# Copy to `.env` before deploying. firebase-functions v2 loads this into
# process.env of every function at deploy time.

# "demo" or "dev" enables the HTTP seedDatabase endpoint. Any other value
# (or unset) makes seedDatabase return 403 "Seed endpoint disabled in production".
ENVIRONMENT=demo

# Optional. When set, seedDatabase additionally requires:
#   Authorization: Bearer <SEED_TOKEN>
# `npm run seed:live` sends no auth header, so leave this unset to use it.
SEED_TOKEN=
